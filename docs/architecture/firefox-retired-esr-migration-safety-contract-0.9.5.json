{
  "$schema": "schemas/firefox-retired-esr-migration-contract-v1.schema.json",
  "schema_version": 1,
  "contract_id": "bpm095-firefox-retired-esr-migration-safety",
  "target_bpm_version": "0.9.5",
  "status": "normative-target-preimplementation",
  "dependencies": {
    "lifecycle_catalog": {
      "contract_id": "bpm095-firefox-schema-lifecycle-catalog",
      "schema_version": 1,
      "path": "docs/architecture/firefox-schema-lifecycle-catalog-contract-0.9.5.json"
    },
    "conversion_contract": {
      "contract_id": "bpm095-firefox-pairwise-profile-conversion",
      "schema_version": 1,
      "path": "docs/architecture/firefox-pairwise-profile-conversion-contract-0.9.5.json"
    },
    "database_upgrade_contract": {
      "contract_version": 2,
      "path": "docs/architecture/database-upgrade-matrix-0.9.4.json"
    }
  },
  "canonical_identity": {
    "canonical_json": "RFC8785-JCS",
    "hash_algorithm": "SHA-256",
    "digest_encoding": "lowercase-hex",
    "transition_manifest_domain": "bpm-retired-esr-transition-manifest:v1\n",
    "total_proof_domain": "bpm-retired-esr-total-proof:v1\n",
    "database_snapshot_domain": "bpm-retired-esr-database-snapshot:v1\n",
    "preflight_evidence_domain": "bpm-retired-esr-preflight-evidence:v1\n"
  },
  "ownership": {
    "sole_writer": "versioned-alembic-retirement-revision",
    "write_phase": "explicit-offline-upgrade",
    "preflight_owner": "versioned-read-only-retirement-preflight",
    "forbidden_write_paths": [
      "application-startup",
      "request-handler",
      "profile-list-or-get",
      "conversion-preview",
      "ui-rendering"
    ],
    "unupgraded_runtime_behavior": {
      "readiness": "fail-closed-before-serving-profile-routes",
      "code": "schema_channel_retired_requires_migration",
      "mutation": "none"
    }
  },
  "successor_selection": {
    "source_family": "esr",
    "selection": "explicit-declared-immediate-newer-supported-esr",
    "comparison_key": "numeric-line-number",
    "target_cardinality": 1,
    "forbid_inference_from": [
      "product-default",
      "latest-esr-recommendation",
      "tuple-or-declaration-order",
      "lexical-artifact-id",
      "maximum-version",
      "stored-profile-samples"
    ],
    "reject": [
      "missing-successor",
      "ambiguous-successor",
      "same-or-older-line",
      "family-mismatch",
      "unsupported-target",
      "skip-over-supported-intermediate-esr",
      "cycle"
    ]
  },
  "retirement_promotion_gate": {
    "required_order": [
      "catalog-diff-valid",
      "successor-valid",
      "exact-artifacts-available",
      "total-convertibility-complete",
      "immutable-transition-manifest-valid",
      "versioned-alembic-revision-present",
      "native-backup-restored-and-verified",
      "database-preflight-complete",
      "guarded-transaction-recheck",
      "single-transaction-apply",
      "postconditions-complete"
    ],
    "support_removal_allowed_only_after": "total-convertibility-complete",
    "migration_revision_creation_allowed_only_after": "total-convertibility-complete",
    "sample_profiles_are_total_proof": false,
    "fail_before_mutation": true
  },
  "total_convertibility": {
    "quantification": "every-instance-valid-under-exact-source-validation-schema",
    "approved_methods": [
      "schema-containment",
      "complete-recipe-partition"
    ],
    "schema_containment_requires": [
      "exact-source-and-target-artifact-identities",
      "exact-normalized-validation-schema-digests",
      "source-valid-implies-target-valid-for-unchanged-document",
      "semantic-equivalence-for-every-source-policy-value-shape",
      "complete-dynamic-key-array-and-empty-container-domain",
      "machine-checkable-proof-artifact"
    ],
    "complete_recipe_partition_requires": [
      "exact-source-and-target-artifact-identities",
      "exact-immutable-recipe-registry-identity",
      "exhaustive-source-schema-domain-partition",
      "pairwise-disjoint-recipe-predicates",
      "lossless-evidence-for-every-partition",
      "complete-source-and-target-atom-accounting",
      "target-validation-for-every-output-domain",
      "machine-checkable-proof-artifact"
    ],
    "forbidden_substitutes": [
      "current-database-profile-scan",
      "sample-profile-success",
      "policy-id-subset-comparison",
      "schema-defaults",
      "best-effort-conversion",
      "manual-conversion-applicability"
    ],
    "complete_status_requires": {
      "exact_artifacts_bound": true,
      "uncovered_schema_locations": 0,
      "blockers": 0
    }
  },
  "preflight": {
    "mode": "read-only-before-transaction",
    "required_static_bindings": [
      "previous-and-candidate-catalog-digests",
      "transition-manifest-digest",
      "exact-source-and-target-artifacts",
      "total-proof-artifact-digest",
      "conversion-contract-version",
      "immutable-recipe-registry-identity",
      "exact-alembic-source-and-target-revisions"
    ],
    "required_database_evidence": [
      "database-identity-digest-and-engine-version",
      "single-known-source-stamp-and-head",
      "expected-profiles-shape",
      "no-active-writers",
      "decodable-json-for-every-affected-row",
      "complete-plan-without-blockers-for-every-affected-row",
      "affected-count-and-canonical-snapshot-digest",
      "native-backup-sha256",
      "separate-restore-check-identity",
      "restored-integrity-stamp-shape-and-row-count-parity",
      "sufficient-space-connectivity-and-privilege"
    ],
    "stale_if_changed": [
      "catalog",
      "artifact-or-schema-identity",
      "recipe-registry",
      "alembic-revision",
      "database-identity",
      "database-stamp",
      "affected-count",
      "profile-revision-document-compliance-or-metadata",
      "backup-or-restore-evidence"
    ],
    "privacy": {
      "evidence_may_contain": [
        "aggregate-counts",
        "artifact-identifiers",
        "database-identity-digest",
        "canonical-row-set-digest",
        "backup-and-manifest-digests",
        "locale-neutral-codes"
      ],
      "logs_must_omit": [
        "policy-values",
        "policy-ids-and-json-pointers",
        "profile-ids-names-and-descriptions",
        "compliance-values-and-notes",
        "credentials-and-database-url",
        "full-document-plan-and-row-digests"
      ]
    }
  },
  "atomic_apply": {
    "transaction_scope": "all-affected-profiles-plus-alembic-version-stamp",
    "writer": "one-versioned-alembic-revision",
    "affected_scope": "all-stored-profiles-on-exact-retired-source-artifact-including-archived",
    "guarded_recheck_before_first_write": [
      "transition-manifest-digest",
      "database-stamp-and-shape",
      "affected-count-and-snapshot-digest",
      "per-profile-revision-and-conversion-plan-identity",
      "source-and-target-schema-identities",
      "recipe-registry-identity",
      "zero-conversion-blockers"
    ],
    "application_write_fields": [
      "schema_version",
      "flags",
      "compliance",
      "revision"
    ],
    "database_managed_fields": [
      "updated_at"
    ],
    "preserved_fields": [
      "id",
      "name",
      "name_casefold",
      "description",
      "created_at",
      "deleted_at"
    ],
    "revision_increment": 1,
    "updated_at_rule": "one-database-managed-transaction-value-for-affected-rows-only",
    "compliance_dispositions": [
      "absent",
      "preserved-verified",
      "recomputed",
      "invalidated-preserved"
    ],
    "target_validation": "mandatory-for-every-affected-result-before-write",
    "commit_count": 1,
    "on_any_error": "rollback-entire-revision-and-preserve-source-stamp",
    "partial_success_reportable": false
  },
  "idempotency_and_interruption": {
    "already_target_rows": "unchanged-including-revision-and-updated-at",
    "zero_source_rows": "valid-no-profile-write-still-stamp-revision",
    "already_applied_revision": "alembic-no-op",
    "already_applied_outcome_code": "retirement_already_applied",
    "retry_before_commit": "rollback-then-restore-verified-backup-to-new-clean-candidate",
    "retry_after_commit": "alembic-no-op-after-read-only-postcondition-verification",
    "ambiguous_commit_result": "read-only-stamp-and-postcondition-inspection-before-any-recovery",
    "partial_or_mixed_state": "block-and-restore-verified-backup-to-new-clean-candidate",
    "in_place_retry_of_failed_candidate": false
  },
  "downgrade": {
    "policy": "unsupported-restore-verified-backup-only",
    "code": "retirement_downgrade_unsupported",
    "downgrade_writes_allowed": false,
    "restore_target": "new-clean-candidate",
    "automatic_database_replacement": false
  },
  "engine_evidence": {
    "sqlite": {
      "required": true,
      "status": "planned-m6-executable-evidence",
      "native_backup": "sqlite-online-backup-or-dot-backup",
      "restore_check": "distinct-absolute-path-with-integrity-check",
      "transaction_boundary": "explicit-write-transaction-covering-all-profile-updates-and-stamp",
      "failure_injections": [
        "before-first-write",
        "after-first-affected-row-before-commit",
        "immediately-before-commit",
        "connection-interruption"
      ],
      "required_assertions": [
        "source-and-backup-unchanged",
        "failed-candidate-source-stamp-and-all-rows-unchanged",
        "no-partial-profile-revisions-or-timestamps",
        "clean-restored-retry-reaches-target-stamp",
        "second-upgrade-is-no-op"
      ],
      "local_gate": "make test-db-recovery"
    },
    "postgresql": {
      "required": true,
      "status": "planned-m6-executable-evidence",
      "native_backup": "pg_dump-custom-serializable-deferrable",
      "restore_check": "pg_restore-exit-on-error-single-transaction-to-isolated-database",
      "transaction_boundary": "one-postgresql-transaction-with-affected-row-lock-and-alembic-stamp",
      "failure_injections": [
        "before-first-write",
        "after-first-affected-row-before-commit",
        "immediately-before-commit",
        "connection-interruption"
      ],
      "required_assertions": [
        "source-and-backup-unchanged",
        "failed-candidate-source-stamp-and-all-rows-unchanged",
        "no-partial-profile-revisions-or-timestamps",
        "clean-restored-retry-reaches-target-stamp",
        "second-upgrade-is-no-op"
      ],
      "ci_gate": "make test-postgres-integration"
    }
  },
  "failure_semantics": [
    {
      "code": "retirement_successor_missing",
      "stage": "static-gate",
      "mutation": "none",
      "recovery": "correct-candidate-catalog-and-regenerate-manifest"
    },
    {
      "code": "retirement_successor_not_immediate",
      "stage": "static-gate",
      "mutation": "none",
      "recovery": "declare-the-immediate-newer-supported-esr"
    },
    {
      "code": "retirement_successor_family_mismatch",
      "stage": "static-gate",
      "mutation": "none",
      "recovery": "declare-one-supported-esr-successor"
    },
    {
      "code": "retirement_total_convertibility_unproven",
      "stage": "static-gate",
      "mutation": "none",
      "recovery": "complete-schema-wide-lossless-proof-before-retirement"
    },
    {
      "code": "retirement_manifest_stale",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "regenerate-review-and-rebind-transition-manifest"
    },
    {
      "code": "retirement_manifest_identity_mismatch",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "restore-exact-reviewed-artifacts-and-rerun-preflight"
    },
    {
      "code": "retirement_backup_unverified",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "create-checksum-restore-and-verify-native-backup"
    },
    {
      "code": "retirement_preflight_stale",
      "stage": "transaction-recheck",
      "mutation": "none",
      "recovery": "discard-evidence-and-rerun-read-only-preflight"
    },
    {
      "code": "conversion_source_schema_missing",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "restore-the-exact-migration-owned-source-schema-artifact"
    },
    {
      "code": "conversion_target_schema_missing",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "restore-the-exact-migration-owned-target-schema-artifact"
    },
    {
      "code": "conversion_source_invalid",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "stop-retirement-and-repair-or-quarantine-invalid-source-data"
    },
    {
      "code": "conversion_recipe_registry_stale",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "restore-the-exact-reviewed-migration-owned-registry"
    },
    {
      "code": "conversion_plan_blocked",
      "stage": "preflight",
      "mutation": "none",
      "recovery": "repair-source-or-complete-owned-conversion-evidence"
    },
    {
      "code": "retirement_transaction_failed",
      "stage": "transaction",
      "mutation": "none",
      "recovery": "retain-failed-candidate-and-retry-from-verified-backup"
    },
    {
      "code": "retirement_partial_state_detected",
      "stage": "recovery-inspection",
      "mutation": "none",
      "recovery": "block-in-place-retry-and-restore-new-clean-candidate"
    },
    {
      "code": "retirement_downgrade_unsupported",
      "stage": "downgrade",
      "mutation": "none",
      "recovery": "restore-verified-pre-upgrade-backup-to-new-clean-candidate"
    }
  ],
