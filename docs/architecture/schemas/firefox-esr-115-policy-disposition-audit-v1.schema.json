{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-policy-manager.local/contracts/firefox-esr-115-policy-disposition-audit-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "target_bpm_version", "status", "source_channel", "artifacts", "evidence", "owner_dispositions", "comparisons", "preset_evidence", "cis_evidence"],
  "properties": {
    "$schema": {"type": "string"}, "schema_version": {"const": 1}, "contract_id": {"const": "bpm095-firefox-esr-115-policy-disposition-audit"}, "target_bpm_version": {"const": "0.9.5.1"}, "status": {"const": "active-audit-and-runtime-guard"}, "source_channel": {"const": "esr-115.39"},
    "artifacts": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "evidence": {"type": "object", "additionalProperties": {"type": "string"}},
    "owner_dispositions": {"type": "object", "required": ["guided", "manual", "raw_fallback", "unsupported_by_channel", "preset", "cis"], "additionalProperties": {"type": "string"}},
    "comparisons": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/comparison"}},
    "preset_evidence": {"type": "object"}, "cis_evidence": {"type": "object"}
  },
  "$defs": {"comparison": {"type": "object", "required": ["target_channel", "source_policy_count", "target_policy_count", "groups"], "additionalProperties": false, "properties": {"target_channel": {"type": "string"}, "source_policy_count": {"type": "integer"}, "target_policy_count": {"type": "integer"}, "groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}}}}, "group": {"type": "object", "required": ["kind", "owner", "stable_identity_prefix", "members"], "additionalProperties": false, "properties": {"kind": {"enum": ["target_only_policy", "changed_path"]}, "owner": {"enum": ["guided", "raw_fallback"]}, "stable_identity_prefix": {"type": "string"}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}}}}
}
