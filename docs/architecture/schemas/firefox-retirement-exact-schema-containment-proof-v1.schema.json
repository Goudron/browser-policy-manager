{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-policy-manager.invalid/contracts/firefox-retirement-exact-schema-containment-proof-v1.schema.json",
  "title": "BPM exact Firefox retirement schema-containment proof version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "contract_version",
    "proof_id",
    "evidence_scope",
    "source",
    "target",
    "successor_line_id",
    "method",
    "recipe_registry",
    "semantic_attestation",
    "containment_evidence",
    "proof_artifact_digest"
  ],
  "properties": {
    "$schema": {"const": "./schemas/firefox-retirement-exact-schema-containment-proof-v1.schema.json"},
    "kind": {"const": "firefox-retirement-exact-schema-containment-proof"},
    "contract_version": {"const": 1},
    "proof_id": {"type": "string", "minLength": 1},
    "evidence_scope": {"const": "production-exact-artifacts"},
    "source": {"$ref": "#/$defs/artifactIdentity"},
    "target": {"$ref": "#/$defs/artifactIdentity"},
    "successor_line_id": {"type": "string", "minLength": 1},
    "method": {"const": "schema-containment"},
    "recipe_registry": {"$ref": "#/$defs/recipeRegistryIdentity"},
    "semantic_attestation": {"$ref": "#/$defs/semanticAttestation"},
    "containment_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/containmentEvidence"}
    },
    "proof_artifact_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "artifact_id", "schema_bundle_sha256", "validation_schema_sha256"],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "schema_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "validation_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recipeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "recipe_version", "definition_digest", "evidence_digest", "evidence_kind"],
      "properties": {
        "recipe_id": {"type": "string"},
        "recipe_version": {"type": "integer", "minimum": 1},
        "definition_digest": {"$ref": "#/$defs/sha256"},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "evidence_kind": {"const": "reversible"}
      }
    },
    "recipeRegistryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_version", "recipes", "registry_digest"],
      "properties": {
        "registry_id": {"const": "firefox-profile-conversion"},
        "registry_version": {"type": "integer", "minimum": 1},
        "recipes": {"type": "array", "items": {"$ref": "#/$defs/recipeIdentity"}},
        "registry_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_tag", "path", "sha256"],
      "properties": {
        "source_tag": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_schema_pointer", "finding"],
      "properties": {
        "source_schema_pointer": {"type": "string", "pattern": "^/properties/"},
        "finding": {"type": "string", "minLength": 1}
      }
    },
    "semanticAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "identity_transform",
        "source_policy_ids",
        "source_policy_ids_sha256",
        "reviewed_upstream_documents",
        "review_findings",
        "semantic_conclusion"
      ],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "identity_transform": {"type": "string", "minLength": 1},
        "source_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_policy_ids_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_upstream_documents": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reviewedDocument"}},
        "review_findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewFinding"}},
        "semantic_conclusion": {"type": "string", "minLength": 1}
      }
    },
    "containmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_digest", "source_schema_pointer", "target_schema_pointer"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "source_schema_pointer": {"const": ""},
        "target_schema_pointer": {"const": ""}
      }
    }
  }
}
