{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-policy-manager.invalid/schemas/firefox-profile-conversion-contract-v1.schema.json",
  "title": "BPM Firefox pairwise profile conversion contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "target_bpm_version",
    "status",
    "implementation",
    "lifecycle_catalog",
    "canonical_identity",
    "classifications",
    "transform_registry_contract",
    "profile_field_accounting",
    "compliance_contract",
    "api_contract",
    "pair_matrix",
    "failure_semantics",
    "examples"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "contract_id": { "const": "bpm095-firefox-pairwise-profile-conversion" },
    "target_bpm_version": { "const": "0.9.5.1" },
    "status": { "const": "active-m4-06-directed-matrix-gate" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "recipes", "preview_api", "apply", "matrix_gate"],
      "properties": {
        "planner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "module", "directed_pairs"],
          "properties": {
            "status": { "const": "implemented" },
            "module": { "const": "app/core/profile_conversion_planner.py" },
            "directed_pairs": { "const": "all-supported-non-self-pairs" }
          }
        },
        "recipes": { "const": "BPM095-M4-02-active-empty-production-registry" },
        "preview_api": { "const": "BPM095-M4-03-read-only-preview-api" },
        "apply": { "const": "BPM095-M4-04-atomic-apply" },
        "matrix_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "command", "tool", "report"],
          "properties": {
            "status": { "const": "implemented" },
            "command": { "const": "make verify-firefox-conversion-matrix" },
            "tool": { "const": "tools/verify_firefox_conversion_matrix.py" },
            "report": { "const": "deterministic-value-free-json" }
          }
        }
      }
    },
    "lifecycle_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "schema_version", "path"],
      "properties": {
        "contract_id": { "const": "bpm095-firefox-schema-lifecycle-catalog" },
        "schema_version": { "const": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "canonical_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_json",
        "hash_algorithm",
        "digest_encoding",
        "document_domain",
        "compliance_domain",
        "metadata_domain",
        "plan_domain",
        "plan_projection"
      ],
      "properties": {
        "canonical_json": { "const": "RFC8785-JCS" },
        "hash_algorithm": { "const": "SHA-256" },
        "digest_encoding": { "const": "lowercase-hex" },
        "document_domain": { "const": "bpm-policy-document:v1\n" },
        "compliance_domain": { "const": "bpm-profile-compliance:v1\n" },
        "metadata_domain": { "const": "bpm-profile-metadata:v1\n" },
        "plan_domain": { "const": "bpm-profile-conversion-plan:v1\n" },
        "plan_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude", "array_order"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "array_order": { "const": "contract-defined-stable-sort" }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "prefixItems": [
        { "const": "unchanged" },
        { "const": "transformed" },
        { "const": "blocked" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform_registry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "versioning",
        "selection",
        "predicates",
        "evidence",
        "determinism",
        "target_validation",
        "production_disposition",
        "forbidden_behaviors"
      ],
      "properties": {
        "registry_id": { "const": "firefox-profile-conversion" },
        "versioning": { "const": "immutable-positive-integer-and-content-digest" },
        "selection": { "const": "exactly-one-match-or-block" },
        "predicates": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "determinism": { "const": "pure-total-on-declared-domain" },
        "target_validation": { "const": "mandatory-after-transform" },
        "production_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "production_recipe_count", "evidence", "all_pair_source_only_policy_counts"],
          "properties": {
            "code": { "const": "no-production-recipe-after-four-channel-diff-audit" },
            "production_recipe_count": { "const": 0 },
            "evidence": { "$ref": "#/$defs/repositoryPath" },
            "all_pair_source_only_policy_counts": {
              "type": "object",
              "minProperties": 12,
              "maxProperties": 12,
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "forbidden_behaviors": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "drop",
              "best-effort",
              "implicit-default",
              "implicit-coercion",
              "first-match-wins",
              "network-or-clock-input",
              "locale-dependent-output"
            ]
          }
        }
      }
    },
    "profile_field_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stored_fields",
        "manual_eligibility",
        "application_write_fields",
        "database_managed_fields",
        "preserved_fields",
        "derived_read_fields",
        "revision_increment"
      ],
      "properties": {
        "stored_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "manual_eligibility": { "const": "active-profile-only" },
        "application_write_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "database_managed_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "preserved_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "derived_read_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "revision_increment": { "const": 1 }
      }
    },
    "compliance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositions",
        "non_null_fallback",
        "claim_rule",
        "leaf_accounting",
        "preserve_requires",
        "recompute_requires",
        "invalidated_envelope_required_fields"
      ],
      "properties": {
        "dispositions": {
          "type": "array",
          "prefixItems": [
            { "const": "absent" },
            { "const": "preserved-verified" },
            { "const": "recomputed" },
            { "const": "invalidated-preserved" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "non_null_fallback": { "const": "invalidated-preserved" },
        "claim_rule": { "const": "no-target-bound-proof-means-no-current-claim" },
        "leaf_accounting": { "const": "every-source-leaf-preserved-transformed-or-blocked" },
        "preserve_requires": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "recompute_requires": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "invalidated_envelope_required_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "api_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_operation",
        "apply_operation",
        "codes_are_locale_neutral",
        "raw_values_in_plan",
        "openapi_change",
        "profile_update_schema_version"
      ],
      "properties": {
        "preview_operation": { "const": "POST /api/profiles/{profile_id}/conversion-preview" },
        "apply_operation": { "const": "POST /api/profiles/{profile_id}/conversion-apply" },
        "codes_are_locale_neutral": { "const": true },
        "raw_values_in_plan": { "const": false },
        "openapi_change": { "const": "additive-new-operations" },
        "profile_update_schema_version": { "const": "deprecated-for-converting-existing-policy-data" }
      }
    },
    "pair_matrix": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/pair" }
    },
    "failure_semantics": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/failureSemantic" }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "apply_request", "result", "error"],
      "properties": {
        "plan": { "$ref": "#/$defs/conversionPlan" },
        "apply_request": { "$ref": "#/$defs/applyRequest" },
        "result": { "$ref": "#/$defs/conversionResult" },
        "error": { "$ref": "#/$defs/conversionError" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "uniqueFieldList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "artifact_id",
        "channel_id",
        "artifact_version",
        "source_tag",
        "schema_bundle_sha256",
        "validation_schema_sha256"
      ],
      "properties": {
        "line_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+$" },
        "artifact_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+(?:\\.[0-9]+)?$" },
        "channel_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+(?:\\.[0-9]+)?$" },
        "artifact_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+$" },
        "source_tag": { "type": "string", "pattern": "^mozilla-policy-templates-(?:v[0-9]+(?:\\.[0-9]+)*|master-[0-9a-f]{40})$" },
        "schema_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "validation_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "lifecycle_state", "metadata_digest"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle_state": { "enum": ["active", "deleted"] },
        "metadata_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "recipeUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "recipe_version",
        "definition_digest",
        "evidence_digest",
        "evidence_kind"
      ],
      "properties": {
        "recipe_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "recipe_version": { "type": "integer", "minimum": 1 },
        "definition_digest": { "$ref": "#/$defs/sha256" },
        "evidence_digest": { "$ref": "#/$defs/sha256" },
        "evidence_kind": { "enum": ["reversible", "semantic-equivalence"] }
      }
    },
    "registryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_version", "registry_digest", "recipes"],
      "properties": {
        "registry_id": { "const": "firefox-profile-conversion" },
        "registry_version": { "type": "integer", "minimum": 1 },
        "registry_digest": { "$ref": "#/$defs/sha256" },
        "recipes": {
          "type": "array",
          "items": { "$ref": "#/$defs/recipeUse" }
        }
      }
    },
    "planEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "policy_id",
        "source_paths",
        "target_paths",
        "classification",
        "unchanged_kind",
        "recipe",
        "evidence_digest",
        "reason_code",
        "source_subtree_digest",
        "target_subtree_digest"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/sha256" },
        "policy_id": { "type": "string", "minLength": 1 },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "target_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "classification": { "enum": ["unchanged", "transformed", "blocked"] },
        "unchanged_kind": {
          "oneOf": [
            { "enum": ["byte-identical", "semantic-equivalent"] },
            { "type": "null" }
          ]
        },
        "recipe": {
          "oneOf": [
            { "$ref": "#/$defs/recipeUse" },
            { "type": "null" }
          ]
        },
        "evidence_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "source_subtree_digest": { "$ref": "#/$defs/sha256" },
        "target_subtree_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "policy_id", "paths"],
      "properties": {
        "code": { "$ref": "#/$defs/reasonCode" },
        "policy_id": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "applicable", "counts"],
      "properties": {
        "status": { "enum": ["compatible-unchanged", "compatible-transformed", "blocked"] },
        "applicable": { "type": "boolean" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_atoms",
            "target_atoms",
            "unchanged_byte",
            "unchanged_semantic",
            "transformed",
            "blocked",
            "warnings",
            "blockers"
          ],
          "properties": {
            "source_atoms": { "type": "integer", "minimum": 0 },
            "target_atoms": { "type": "integer", "minimum": 0 },
            "unchanged_byte": { "type": "integer", "minimum": 0 },
            "unchanged_semantic": { "type": "integer", "minimum": 0 },
            "transformed": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "blockers": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "targetValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validated_document_digest", "validation_schema_sha256", "issues"],
      "properties": {
        "status": { "enum": ["valid", "invalid", "not-run-precondition-failed"] },
        "validated_document_digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "validation_schema_sha256": { "$ref": "#/$defs/sha256" },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "complianceDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reason_code",
        "source_digest",
        "target_digest",
        "target_claims_current",
        "target_cis_artifact_digest",
        "accounted_source_paths"
      ],
      "properties": {
        "disposition": {
          "enum": ["absent", "preserved-verified", "recomputed", "invalidated-preserved"]
        },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "target_digest": { "$ref": "#/$defs/sha256" },
        "target_claims_current": { "type": "boolean" },
        "target_cis_artifact_digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "accounted_source_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        }
      }
    },
    "conversionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "profile",
        "source",
        "target",
        "recipe_registry",
        "compatibility",
        "entries",
        "target_validation",
        "compliance",
        "warnings",
        "blockers",
        "plan_digest"
      ],
      "properties": {
        "kind": { "const": "profile-conversion-plan" },
        "contract_version": { "const": 1 },
        "profile": { "$ref": "#/$defs/profileIdentity" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "document_digest", "compliance_digest"],
          "properties": {
            "artifact": { "$ref": "#/$defs/artifactIdentity" },
            "document_digest": { "$ref": "#/$defs/sha256" },
            "compliance_digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "candidate_document_digest"],
          "properties": {
            "artifact": { "$ref": "#/$defs/artifactIdentity" },
            "candidate_document_digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "recipe_registry": { "$ref": "#/$defs/registryIdentity" },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/planEntry" }
        },
        "target_validation": { "$ref": "#/$defs/targetValidation" },
        "compliance": { "$ref": "#/$defs/complianceDisposition" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "plan_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "applyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "profile_id",
        "expected_revision",
        "source",
        "target",
        "target_artifact_id",
        "plan_digest",
        "source_document_digest",
        "source_compliance_digest",
        "source_metadata_digest",
        "source_validation_schema_sha256",
        "target_validation_schema_sha256",
        "recipe_registry_version",
        "recipe_registry_digest"
      ],
      "properties": {
        "kind": { "const": "profile-conversion-apply-request" },
        "contract_version": { "const": 1 },
        "profile_id": { "type": "integer", "minimum": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/lineArtifactReference" },
        "target": { "$ref": "#/$defs/lineArtifactReference" },
        "target_artifact_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+(?:\\.[0-9]+)?$" },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "source_document_digest": { "$ref": "#/$defs/sha256" },
        "source_compliance_digest": { "$ref": "#/$defs/sha256" },
        "source_metadata_digest": { "$ref": "#/$defs/sha256" },
        "source_validation_schema_sha256": { "$ref": "#/$defs/sha256" },
        "target_validation_schema_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_registry_version": { "type": "integer", "minimum": 1 },
        "recipe_registry_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "artifact_id"],
      "properties": {
        "line_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+$" },
        "artifact_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+(?:\\.[0-9]+)?$" }
      }
    },
    "conversionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "status",
        "profile_id",
        "source_revision",
        "result_revision",
        "source",
        "target",
        "plan_digest",
        "result_document_digest",
        "result_compliance_digest",
        "compliance",
        "target_validation",
        "field_accounting"
      ],
      "properties": {
        "kind": { "const": "profile-conversion-result" },
        "contract_version": { "const": 1 },
        "status": { "const": "applied" },
        "profile_id": { "type": "integer", "minimum": 1 },
        "source_revision": { "type": "integer", "minimum": 1 },
        "result_revision": { "type": "integer", "minimum": 2 },
        "source": { "$ref": "#/$defs/lineArtifactReference" },
        "target": { "$ref": "#/$defs/lineArtifactReference" },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "result_document_digest": { "$ref": "#/$defs/sha256" },
        "result_compliance_digest": { "$ref": "#/$defs/sha256" },
        "compliance": { "$ref": "#/$defs/complianceDisposition" },
        "target_validation": { "$ref": "#/$defs/targetValidation" },
        "field_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "application_write_fields",
            "database_managed_fields",
            "preserved_fields",
            "updated_at_changed"
          ],
          "properties": {
            "application_write_fields": { "$ref": "#/$defs/uniqueFieldList" },
            "database_managed_fields": { "$ref": "#/$defs/uniqueFieldList" },
            "preserved_fields": { "$ref": "#/$defs/uniqueFieldList" },
            "updated_at_changed": { "type": "boolean" }
          }
        }
      }
    },
    "conversionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "code",
        "http_status",
        "profile_id",
        "expected_revision",
        "current_revision",
        "plan_digest",
        "retry_preview_required",
        "mutation",
        "parameters"
      ],
      "properties": {
        "kind": { "const": "profile-conversion-error" },
        "contract_version": { "const": 1 },
        "code": { "$ref": "#/$defs/reasonCode" },
        "http_status": { "type": "integer", "enum": [404, 409, 422, 500, 503] },
        "profile_id": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "expected_revision": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "current_revision": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "plan_digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "retry_preview_required": { "type": "boolean" },
        "mutation": { "const": "none" },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"]
          }
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "source_line_id",
        "source_artifact_id",
        "target_line_id",
        "target_artifact_id",
        "required",
        "artifact_availability",
        "runtime_status"
      ],
      "properties": {
        "pair_id": {
          "type": "string",
          "pattern": "^(?:release|esr)-[0-9]+(?:\\.[0-9]+)?--to--(?:release|esr)-[0-9]+(?:\\.[0-9]+)?$"
        },
        "source_line_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+$" },
        "source_artifact_id": { "type": "string", "minLength": 1 },
        "target_line_id": { "type": "string", "pattern": "^(?:release|esr)-[0-9]+$" },
        "target_artifact_id": { "type": "string", "minLength": 1 },
        "required": { "const": true },
        "artifact_availability": { "const": "current" },
        "runtime_status": { "const": "planner-runtime-active-empty-production-registry" }
      }
    },
    "failureSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "code", "http_status", "stage", "mutation"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/reasonCode" },
        "http_status": { "type": "integer", "enum": [404, 409, 422, 500, 503] },
        "stage": { "enum": ["preview", "apply", "both"] },
        "mutation": { "const": "none" }
      }
    }
  }
}
