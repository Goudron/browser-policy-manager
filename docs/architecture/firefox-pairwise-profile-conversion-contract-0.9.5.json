  "failure_semantics": [
    {
      "condition": "profile does not exist",
      "code": "conversion_profile_not_found",
      "http_status": 404,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "source profile is deleted or otherwise not active",
      "code": "conversion_source_not_active",
      "http_status": 409,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "stored source channel is unknown",
      "code": "schema_channel_unknown",
      "http_status": 409,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "stored source channel is retired and requires migration",
      "code": "schema_channel_retired_requires_migration",
      "http_status": 409,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "target channel is unknown",
      "code": "schema_channel_unknown",
      "http_status": 422,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "target channel is known but retired",
      "code": "schema_channel_retired",
      "http_status": 422,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "target channel is known but unsupported or unavailable",
      "code": "conversion_target_unsupported",
      "http_status": 422,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "target exact artifact equals source exact artifact",
      "code": "conversion_target_identical",
      "http_status": 422,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "source policies do not validate under the exact stored source artifact",
      "code": "conversion_source_invalid",
      "http_status": 422,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "exact source schema artifact is missing or unreadable",
      "code": "conversion_source_schema_missing",
      "http_status": 503,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "exact target schema artifact is missing or unreadable",
      "code": "conversion_target_schema_missing",
      "http_status": 503,
      "stage": "both",
      "mutation": "none"
    },
    {
      "condition": "apply expected revision differs from current profile revision",
      "code": "conversion_revision_stale",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "current document, compliance, or metadata digest differs from apply request",
      "code": "conversion_source_identity_stale",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "rederived plan digest differs from requested preview digest",
      "code": "conversion_plan_stale",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "source or target schema identity differs from apply request",
      "code": "conversion_schema_identity_stale",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "transform registry identity differs from apply request",
      "code": "conversion_recipe_registry_stale",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "rederived conversion plan contains one or more blockers",
      "code": "conversion_plan_blocked",
      "http_status": 409,
      "stage": "apply",
      "mutation": "none"
    },
    {
      "condition": "apply validation, persistence, flush, or commit fails before successful commit",
      "code": "conversion_apply_failed",
      "http_status": 500,
      "stage": "apply",
      "mutation": "none"
    }
  ],
