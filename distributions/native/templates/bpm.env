# BPM 0.9.6 native-package configuration.
# This file contains no credentials. Keep any operator-owned secret outside
# the package and protect it with the platform's normal configuration policy.
BPM_DATABASE_URL=sqlite+aiosqlite:////var/lib/bpm/bpm.db
BPM_DOCUMENTATION_SITE_DIR=/opt/bpm/documentation/site
BPM_HOST=127.0.0.1
BPM_PORT=8000
BPM_RELOAD=false
