{
  "schema_version": 1,
  "backlog_item": "BPM090-M12-07",
  "target_bpm_version": "0.9.0",
  "status": "accepted",
  "purpose": "Keep documentation-only debugging inside documentation/tests with compact fixtures and explicit suite ownership.",
  "pytest_discovery_boundary": {
    "current_default_testpaths": ["tests"],
    "documentation_tests_are_run_by_focused_make_targets": true,
    "implemented_make_targets_backlog_item": "BPM090-M12-07",
    "general_tests_tree_may_keep_cross_boundary_contracts": true
  },
  "make_targets": {
    "test-docs": {
      "purpose": "Run documentation unit and contract suites without browser, live Firefox, or general BPM test discovery.",
      "command": "make test-docs",
      "paths": ["documentation/tests/unit/", "documentation/tests/contract/"],
      "browser_backed": false
    },
    "test-docs-contract": {
      "purpose": "Run only documentation docs_contract tests.",
      "command": "make test-docs-contract",
      "paths": ["documentation/tests/contract/"],
      "browser_backed": false
    },
    "test-docs-ui": {
      "purpose": "Run documentation portal/UI non-browser contracts and browser-backed smoke.",
      "command": "make test-docs-ui",
      "paths": [
        "documentation/tests/contract/test_portal_shell_theme.py",
        "documentation/tests/contract/test_manifest_generation.py",
        "documentation/tests/browser/"
      ],
      "browser_backed": true,
      "sandbox_escalation_note": "Documentation UI browser smoke requires immediate sandbox escalation."
    },
    "test-docs-ui-contract": {
      "purpose": "Run only documentation portal/UI non-browser contracts.",
      "command": "make test-docs-ui-contract",
      "paths": [
        "documentation/tests/contract/test_portal_shell_theme.py",
        "documentation/tests/contract/test_manifest_generation.py"
      ],
      "browser_backed": false
    },
    "test-docs-browser": {
      "purpose": "Run browser-backed documentation portal smoke for BPM links and /help/ behavior.",
      "command": "make test-docs-browser",
      "paths": ["documentation/tests/browser/"],
      "browser_backed": true,
      "sandbox_escalation_note": "Launches Chromium/Selenium and therefore requires immediate sandbox escalation."
    },
    "docs-snapshot": {
      "purpose": "Regenerate the bounded documentation subsystem snapshot for future Codex sessions.",
      "command": "make docs-snapshot",
      "paths": ["documentation/tools/generate_subsystem_snapshot.py"],
      "browser_backed": false
    },
    "docs-fast-check": {
      "purpose": "Validate changed documentation source inputs and report affected locale, guide, search, and output areas before the full corpus.",
      "command": "make docs-fast-check",
      "paths": ["documentation/tools/build_docs.py"],
      "browser_backed": false
    },
    "docs-coverage": {
      "purpose": "Run isolated documentation-code coverage for the accepted coverage policy.",
      "command": "make docs-coverage",
      "paths": ["documentation/tests/unit/test_validate_metadata.py"],
      "browser_backed": false
    },
    "docs-release-check": {
      "purpose": "Run the release-blocking documentation gate before the general BPM release suite.",
      "command": "make docs-release-check",
      "paths": [
        "documentation/tools/build_docs.py",
        "documentation/tests/contract/"
      ],
      "browser_backed": false
    }
  },
  "suites": {
    "unit": {
      "path": "documentation/tests/unit/",
      "owner": "documentation tooling unit tests",
      "marker_policy": "unit-style tests may remain unmarked until M11-02 command selection is implemented",
      "scope": [
        "pure documentation build helpers",
        "toolchain bootstrap behavior",
        "manifest/search generation helpers with compact temporary trees"
      ],
      "must_not_require": [
        "browser",
        "network",
        "installed documentation artifact",
        "production database",
        "full generated site scan"
      ]
    },
    "contract": {
      "path": "documentation/tests/contract/",
      "owner": "documentation source, content, manifest, search, link, and release-shape contracts",
      "marker_policy": "all tests use pytestmark = pytest.mark.docs_contract",
      "scope": [
        "DITA maps and topic structure",
        "content and locale parity",
        "manifest, target map, artifact, and publishing contracts",
        "search corpus, normalization, ranking, facets, quality, and integrity contracts",
        "source inventory drift and API example synchronization"
      ],
      "must_not_require": [
        "browser",
        "live Firefox",
        "ignored generated output",
        "customer data",
        "licensed source PDFs"
      ]
    },
    "browser": {
      "path": "documentation/tests/browser/",
      "owner": "documentation browser smoke, accessibility, responsive, search UI, and screenshot checks",
      "marker_policy": "future tests must use browser_ui or the M11-02 documentation UI selector and immediate sandbox escalation",
      "scope": [
        "portal navigation in a real browser",
        "BPM header/contextual help entry flow",
        "keyboard/focus behavior",
        "responsive and theme behavior",
        "locale switching",
        "search UI behavior",
        "screenshot capture validation"
      ],
      "must_not_require": [
        "production database",
        "external network search",
        "unreviewed screenshots",
        "sandboxed browser trial before escalation"
      ]
    }
  },
  "domains": {
    "dita": {
      "primary_suite": "contract",
      "path_globs": [
        "documentation/tests/contract/test_guide_maps.py",
        "documentation/tests/contract/test_metadata_contract.py",
        "documentation/tests/contract/test_authoring_runbooks.py"
      ],
      "fixtures": ["documentation/fixtures/metadata-filter/"],
      "focused_rerun": "./.venv/bin/pytest -q -m docs_contract documentation/tests/contract/test_guide_maps.py documentation/tests/contract/test_metadata_contract.py"
    },
    "content": {
      "primary_suite": "contract",
