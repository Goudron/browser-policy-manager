  "compact_fixture_rules": {
    "allowed": [
      "small synthetic JSON examples",
      "minimal DITA maps/topics",
      "locale-neutral metadata fixtures",
      "reviewed source assets referenced by ID",
      "deterministic API/import/export examples without credentials"
    ],
    "forbidden": [
      "production databases",
      "customer profiles",
      "secrets",
      "private hosts",
      "full generated sites",
      "full external corpora",
      "official CIS PDFs",
      "browser downloads",
      "ignored build, dist, reports, or cache output"
    ]
  },
  "general_tests_boundary": {
    "allowed_cross_boundary_contracts": [
      "architecture decisions under docs/architecture/",
      "runtime bridge contracts that must import app/documentation/",
      "repository-level docs index and context-guide contracts",
      "pytest marker policy and release-gate contracts"
    ],
    "must_not_debug_from_general_tests": [
      "DITA topic authoring failures",
      "locale parity failures",
      "search index fixture drift",
      "manifest generation internals",
      "screenshot capture issues",
      "API example source fixtures"
    ]
  }
}
