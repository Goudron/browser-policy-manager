    },
    {
      "id": "M8R-02",
      "severity": "high",
      "finding": "Managed-path validation did not reject an encoded/backslash path component or a symlink located above the configured managed root.",
      "resolution": "Execution-path admission rejects encoded separators, backslashes, alternate-stream colons, controls and every existing symlink component from the filesystem anchor through the managed file.",
      "regression": "tests/integration/ai/core/test_ai_least_privilege.py"
    }
  ],
