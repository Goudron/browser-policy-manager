        "ui_state": {
          "surface": "all-settings",
          "mode": "configured",
          "filter": "configured",
          "selected_setting": "Homepage"
        },
        "wait_for_selectors": [
          "#settings-panel",
          "#all-settings-list [data-settings-entry-id]"
        ]
      },
      "json-editor": {
        "state_id": "shot-state-json-editor",
        "primary_profile_id": "doc-profile-release-baseline",
        "schema_channel": "release-152",
        "route_parameters": { "profile_id": "doc-profile-release-baseline" },
        "ui_state": {
          "surface": "json-editor",
          "document_state": "valid",
          "validation_status": "ready",
          "cursor": "hidden-before-capture"
        },
        "wait_for_selectors": ["#editor-panel", "#editor"]
      },
      "compare-profiles": {
        "state_id": "shot-state-compare-profiles",
        "primary_profile_id": "doc-profile-release-baseline",
        "secondary_profile_id": "doc-profile-esr-archived",
        "schema_channel": "release-152",
        "secondary_schema_channel": "esr-140.12",
        "route_parameters": {},
        "ui_state": {
          "surface": "profile-comparison",
          "left_profile_id": "doc-profile-release-baseline",
          "right_profile_id": "doc-profile-esr-archived",
          "difference_filter": "all"
        },
        "wait_for_selectors": ["#compare-page", ".context-help-link"]
      }
    }
  },
