{
  "schema_version": 1,
  "target_bpm_version": "0.9.1",
  "backlog_item": "BPM091-M2-02",
  "guide_id": "user-guide",
  "status": "defined",
  "matrix_id": "bpm-0.9.1-minimal-user-guide-screenshots",
  "locales": ["en", "ru", "de", "zh-CN", "fr", "es-ES"],
  "scope": {
    "included": "Minimal BPM User Guide screenshots only.",
    "excluded_guides": [
      "firefox-policy-guide",
      "cis-settings-guide",
      "api-integration-guide",
      "administrator-guide"
    ],
    "non_goals": [
      "full screenshot coverage for every User Guide topic",
      "Firefox Policy reference screenshots",
      "CIS recommendation screenshots",
      "API or Administrator/DevOps screenshots"
    ]
  },
  "source_asset_root": "documentation/assets/screenshots/{locale}/",
  "temporary_output_root": "documentation/reports/screenshots/",
  "capture_rules": [
    "Use synthetic fixture data only.",
    "Capture every matrix row for every listed locale.",
    "Keep the same filename stem in every locale directory.",
    "Do not reuse a screenshot across locales unless a later task records a language-neutral exception.",
    "Captions and alt text are localized in DITA topics by the integration task."
  ],
  "capture_execution": {
    "backlog_item": "BPM091-M5-02",
    "command": "./.venv/bin/python documentation/tools/capture_user_guide_screenshots.py",
    "browser": "Chromium/Selenium",
    "sandbox": "requires immediate sandbox escalation",
    "writes_assets": "documentation/assets/screenshots/{locale}/",
    "writes_reports": "documentation/reports/screenshots/"
  },
  "asset_normalization": {
    "backlog_item": "BPM091-M5-03",
    "status": "accepted",
    "storage_root": "documentation/assets/screenshots/{locale}/",
    "format": "png",
    "allowed_chunks": ["IHDR", "IDAT", "IEND"],
    "metadata_policy": "no ancillary PNG metadata chunks",
    "filename_pattern": "^ug-[a-z0-9]+(?:-[a-z0-9]+)*-(desktop|narrow)-(light|dark)\\.png$",
    "max_bytes_by_viewport": {
      "desktop": 358400,
      "narrow": 102400
    },
    "orphan_policy": "every PNG under documentation/assets/screenshots must be referenced by exactly one matrix row",
    "cross_locale_policy": "same-scenario screenshots must have distinct SHA-256 hashes across locales unless an explicit exception is added later"
  },
  "topic_integration": {
    "backlog_item": "BPM091-M5-04",
    "status": "accepted",
    "source_key_pattern": "screenshot.{scenario_id}",
    "source_figure_id_pattern": "screenshot-{scenario_id}",
    "published_asset_root": "{locale}/assets/screenshots/",
    "caption_policy": "each integrated figure title is authored in the topic locale",
    "alt_text_policy": "each integrated image alt text is authored in the topic locale",
    "fallback_policy": "no localized topic may resolve a screenshot, caption, or alt text from another locale"
  },
  "capture_state_contract": {
    "backlog_item": "BPM091-M5-01",
    "status": "frozen",
    "profile_fixture_source": "documentation/fixtures/profile-states/profile-states-0.9.0.json",
    "runtime": {
      "database": "temporary sqlite database under documentation/reports/screenshots/runtime/",
      "browser_profile": "temporary browser profile under documentation/reports/screenshots/browser-profiles/",
      "seed_mode": "recreate from synthetic fixtures for every capture run",
      "network": "localhost only",
      "forbidden_sources": [
        "production databases",
        "local user browser profiles",
        "customer profiles",
        "secrets",
        "private hosts"
      ]
    },
    "viewports": {
      "desktop": { "width": 1440, "height": 1000, "device_scale_factor": 1 },
      "narrow": { "width": 390, "height": 900, "device_scale_factor": 1 }
    },
    "required_failure_context_fields": [
      "locale",
      "topic_id",
      "route",
      "state_id",
      "matrix_row_id",
      "scenario_id",
      "viewport",
      "theme",
      "schema_channel",
      "fixture_state",
      "asset_path"
    ],
    "scenario_ui_states": {
      "library-overview": {
        "state_id": "shot-state-library-overview",
        "primary_profile_id": "doc-profile-release-baseline",
        "schema_channel": "release-152",
        "route_parameters": {},
        "ui_state": {
          "surface": "profile-library",
          "search_query": "",
          "sort": "name-ascending",
