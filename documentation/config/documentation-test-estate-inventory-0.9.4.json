{
  "schema_version": 1,
  "inventory_id": "bpm-0.9.4-documentation-test-estate",
  "backlog_item": "BPM094-M11A-01",
  "target_bpm_version": "0.9.4",
  "status": "accepted-for-layer-rationalization",
  "purpose": "Classify every maintained documentation test by the responsible owner, reader-visible or delivery risk, expected execution cost, and source coupling before M11A changes commands or assertions.",
  "maintained_test_roots": [
    "documentation/tests/unit",
    "documentation/tests/contract",
    "documentation/tests/browser",
    "tests/contract/docs"
  ],
  "layers": {
    "fast_edit_time": "Targeted, deterministic source or helper checks suitable for the bounded authoring command defined by BPM094-M11A-02.",
    "release_gate": "Fail-closed structural, localization, PDF, security, runtime, or delivery protection retained by the authoritative release chain.",
    "scheduled_audit": "Periodic review or bounded snapshot evidence; it is not required for every ordinary editorial change.",
    "remove_replace": "A historical or brittle witness retained until BPM094-M11A-03 replaces it with an explicit semantic authority contract; this inventory does not remove or skip it."
  },
  "coupling_types": [
    "semantic",
    "structural",
    "fixture",
    "literal_text",
    "snapshot",
    "obsolete_evidence",
    "binary_artifact",
    "runtime_boundary"
  ],
  "classifications": [
    {
      "id": "docs-unit-fast",
      "include": ["documentation/tests/unit/test_*.py"],
      "exclude": ["documentation/tests/unit/test_generate_subsystem_snapshot.py"],
      "owner": "documentation build tooling maintainers",
      "asserted_risks": ["build-helper regression", "source-validation regression", "deterministic fixture regression"],
      "execution_cost": "low; pure helpers and compact temporary trees",
      "coupling": ["semantic", "structural", "fixture"],
      "layer": "fast_edit_time",
      "rationale": "These tests have no browser, network, installed-site, or full-corpus requirement."
    },
    {
