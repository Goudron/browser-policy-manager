      "execution_cost": "medium; bounded source/index scan",
      "coupling": ["snapshot", "structural"],
      "layer": "scheduled_audit",
      "rationale": "Snapshots and indexes are useful review evidence but must be regenerated only by their owner and must not block unrelated prose edits."
