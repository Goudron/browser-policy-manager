    "purpose": "Define reviewed terminology sources, replacement terms, and visible-English allowlists for BPM 0.9.1 localization cleanup before source string replacement.",
    "authority_policy": {
        "priority_order": [
            "mozilla_pontoon",
            "mozilla_sumo",
            "maintainer_fallback"
        ],
        "mozilla_pontoon": "Primary source for Firefox UI terminology, localized product nouns, and common action labels.",
        "mozilla_sumo": "Secondary source for user-facing help vocabulary; use only reviewed localized terms and repeated UI nouns, not untranslated English leaked by machine translation.",
        "maintainer_fallback": "Allowed only when BPM has a product-specific concept absent from Pontoon/SUMO or when source evidence conflicts; the note must explain the fallback.",
        "do_not_translate": "Brands, stable abbreviations, commands, paths, APIs, Firefox policy IDs, preference IDs, JSON literals, filenames, URLs, and placeholders stay language-neutral."
    },
    "authority_sources": {
        "pontoon_lookup_template": "https://pontoon.mozilla.org/{locale}/firefox/all-resources/?search={source_term}",
        "sumo_lookup_template": "https://support.mozilla.org/{locale}/kb/{article_slug}",
