    "allowlist": {
        "brand": {
            "examples": [
                "Browser Policy Manager",
                "Firefox",
                "Mozilla",
                "SUMO"
            ],
            "rationale": "Brand and product names stay stable across locales."
        },
        "abbreviation": {
            "examples": [
                "AI",
                "API",
                "BPM",
                "CIS",
                "ESR",
                "JSON",
                "URL",
                "WSL"
            ],
            "rationale": "Technical abbreviations remain visible when they name formats, standards, product modes, or guide families."
        },
        "identifier": {
            "examples": [
                "DisableTelemetry",
                "Homepage",
                "Locked",
                "browser.startup.homepage",
                "browser.tabs.warnOnClose",
                "true",
                "false"
            ],
            "rationale": "Firefox policy IDs, managed preference IDs, schema enum values, and JSON literals are identifiers, not prose."
        },
        "command/path/API": {
            "examples": [
                "policies.json",
                "about:profiles",
                "https://portal.example.test/",
                "GET /api/profiles",
                "firefox -P"
            ],
            "rationale": "Commands, paths, URLs, API routes, and boundary filenames must remain exact."
        },
        "placeholder": {
            "examples": [
                "{name}",
                "{file}",
                "{count}"
            ],
            "rationale": "Runtime placeholders are contract identifiers and must not be localized."
        }
    },
