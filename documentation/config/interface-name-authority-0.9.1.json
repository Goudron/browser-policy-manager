{
  "schema_version": 1,
  "authority_id": "bpm-0.9.1-interface-name-authority",
  "target_bpm_version": "0.9.1",
  "backlog_item": "BPM091-M10-04",
  "status": "accepted",
  "purpose": "Make the maintained BPM runtime locale catalogs the single authority for interface names used by product documentation.",
  "inherits_from": [
    "documentation/config/documentation-navigation-locale-completion-audit-0.9.1.json",
    "documentation/config/locale-terminology-authority-0.9.1.json",
    "app/i18n_src/catalog-order.json"
  ],
  "locales": ["en", "ru", "de", "zh-CN", "fr", "es-ES"],
  "authority_rule": {
    "value_source": "app/i18n/{locale}.json::{catalog_key}",
    "source_catalog_boundary": "app/i18n_src/{locale}/ plus generated catalog assembly",
    "resolution": "Resolve the same catalog_key in the active documentation locale; never translate the English value independently and never fall back to another locale.",
    "matching": "Documentation may inflect surrounding prose, but an interface name in a title, heading, navigation label, caption, alt text, or prose must preserve the locale-owned runtime term.",
    "catalog_correction": "If a runtime value is visibly untranslated, incomplete, or malformed, correct the maintained runtime source first and then consume that same key in documentation.",
    "technical_boundary": "Brands, abbreviations, identifiers, commands, paths, APIs, file names, schema channels, and generic structural descriptions use their reviewed non-UI authority class instead of a BPM UI key."
  },
  "surface_scope": [
    "topic_title",
    "section_heading",
    "navigation_label",
    "breadcrumb",
    "search_result_title",
    "caption",
    "alt_text",
    "prose"
  ],
