{
  "schema_version": 1,
  "contract_id": "bpm-doc-search-ranking-typo-0.9.0",
  "backlog_item": "BPM090-M10-04",
  "target_bpm_version": "0.9.0",
  "status": "accepted",
  "non_ai_boundary": "no-ai-no-rag-no-embeddings-no-generative-answers",
  "ranking_order": [
    "exact_identifier",
    "title",
    "alias",
    "heading",
    "body",
    "bounded_typo"
  ],
  "weights": {
    "exact_identifier": 1000,
    "title": 180,
    "alias": 140,
    "heading": 80,
    "body": 20,
    "bounded_typo": 12,
    "recency": 0
  },
  "typo_tolerance": {
    "algorithm": "bounded-levenshtein",
    "min_token_length": 5,
    "max_token_length": 32,
    "max_distance_by_length": [
      {
        "min_length": 5,
        "max_length": 8,
        "max_distance": 1
      },
      {
        "min_length": 9,
        "max_length": 32,
        "max_distance": 2
      }
    ],
    "fields": [
      "title",
      "aliases",
      "headings"
    ],
    "excluded_token_patterns": [
      "^/[A-Za-z0-9._/-]+$",
      "^[A-Za-z]+:[A-Za-z0-9._:-]+$",
      "^[A-Z]{2,}-[A-Z]{2,}-[0-9]+$",
      "^[0-9]+(?:\\.[0-9]+)+$"
    ]
  },
  "tie_breakers": [
    "score_desc",
    "exact_identifier_desc",
    "title_desc",
    "alias_desc",
    "guide_id",
    "topic_id"
  ],
  "ranking_fixtures": [
    {
      "fixture_id": "exact-policy-ai-controls",
      "locale": "en",
      "query": "AIControls",
      "expected_top_topic_id": "fx-concept-complex-policy-families",
      "required_score_component": "exact_identifier"
    },
