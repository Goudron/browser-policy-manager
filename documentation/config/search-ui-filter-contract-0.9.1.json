{
  "schema_version": 1,
  "contract_id": "bpm-doc-search-ui-filter-contract-0.9.1",
  "backlog_item": "BPM091-M2-04",
  "target_bpm_version": "0.9.1",
  "status": "accepted",
  "inherits_from": [
    "documentation/config/search-corpus-and-results-0.9.0.json",
    "documentation/config/search-facets-filters-0.9.0.json",
    "documentation/config/search-quality-performance-0.9.0.json",
    "documentation/config/search-integrity-drift-0.9.0.json"
  ],
  "search_mode": "deterministic-local-static",
  "non_ai_boundary": {
    "mode": "no-ai-no-rag-no-embeddings-no-generative-answers",
    "note": "The 0.9.1 work changes presentation and localization only; ranking, corpus generation, static indexes, and local/offline search remain governed by the inherited 0.9.0 contracts."
  },
  "default_state": {
    "layout": "one-line-compact",
    "visible_controls": [
      "query_input",
      "submit",
      "clear",
      "advanced_toggle"
    ],
    "collapsed_by_default": [
      "help_text",
      "filter_groups",
      "facet_counts",
      "result_list"
    ],
    "must_not_show_by_default": [
      "multi-row filter panel",
      "expanded facet grid",
      "empty result instructions before a query or selected filter",
      "duplicated filter parameter labels"
    ],
    "height_rule": "The first-load search control must be visually equivalent to a single toolbar row at desktop widths; narrow viewports may wrap buttons only as needed for readable controls."
  },
  "expansion_behavior": {
    "trigger": "explicit advanced-options disclosure control",
    "submission_behavior": "Submitting a query with Enter or the search button preserves the current disclosure state.",
    "url_restore_behavior": "Restoring a search URL preserves the collapsed filter panel while restoring its query and selected filters.",
    "state_source": "URL query parameters and in-page state only",
    "preserve_on_expand": [
      "query text",
      "selected filters",
      "current locale",
      "keyboard focus order",
      "aria-expanded state"
    ],
    "preserve_on_collapse": [
      "query text",
      "selected filters",
      "result set",
      "URL state"
    ],
    "must_not": [
      "change deterministic ranking",
      "expand a collapsed filter panel when submitting a query",
      "reload from a remote service",
      "clear query text",
      "trap keyboard focus",
      "hide selected filters without a visible summary"
    ]
  },
  "localized_labels": {
    "source": "locale-owned documentation shell/search catalogs generated into each locale output",
    "fallback_policy": "fail closed for visible labels; English fallback is not allowed in non-English locales except allowlisted identifiers, brands, product names, commands, paths, and API abbreviations",
    "hidden_facets": [
      "locale",
      "bpm_version"
    ],
    "visible_facets": [
      "guide_id",
      "topic_kind",
      "firefox_channel",
      "policy_category",
      "cis_level",
      "cis_control_state",
      "api_area"
    ],
    "allowlisted_visible_identifiers": [
      "API",
      "BPM",
      "CIS",
      "Firefox",
      "ESR",
      "Release"
    ],
    "required_locale_keys": [
      "search.advanced_toggle",
      "search.advanced_toggle_expanded",
      "search.selected_filters_summary",
      "search.clear_filter",
      "search.clear_all_filters",
      "search.empty_with_filters",
      "search.empty_without_filters",
      "search.filter.guide_id",
      "search.filter.topic_kind",
      "search.filter.firefox_channel",
      "search.filter.policy_category",
      "search.filter.cis_level",
      "search.filter.cis_control_state",
      "search.filter.api_area",
      "search.value.*"
    ]
  },
