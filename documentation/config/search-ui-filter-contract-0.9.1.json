  "facet_persistence": {
    "query_parameter_contract": "Reuse the inherited repeat-parameter URL contract from search-facets-filters-0.9.0.json.",
    "compact_summary": "When the panel is collapsed and filters are selected, show a localized summary with a clear-all action.",
    "restore_on_load": "Restore query and selected filters from URL state before recent-query local storage.",
    "must_preserve": [
      "result URLs",
      "highlighting",
      "empty-result state",
      "selected filter counts",
      "direct links to filtered search states"
    ]
  },
  "keyboard_access": {
    "requirements": [
      "Tab order reaches query input, submit, clear, advanced toggle, filter groups, clear-filter controls, and result links in DOM order.",
      "Enter submits the query from the input.",
      "Space and Enter toggle the advanced options disclosure.",
      "Escape collapses advanced options only when focus remains inside the search component and does not clear the query.",
      "Status changes are announced through the existing polite live region.",
      "Visible selected filters remain removable with a keyboard."
    ]
  },
  "empty_result_recovery": {
    "with_filters": "Show the localized empty-with-filters message, keep selected filters visible, and offer clear-filter and clear-all controls.",
    "without_filters": "Show the localized empty-without-filters message and keep the query editable.",
    "must_not": [
      "offer AI answers",
      "send the query to a network service",
      "drop the user's query or selected filters"
    ]
  },
  "implementation_tasks": [
    "BPM091-M4-01",
    "BPM091-M4-02",
    "BPM091-M4-03",
    "BPM091-M4-07"
  ],
  "verification": {
    "focused_contracts": [
      "./.venv/bin/pytest -q -m docs_contract documentation/tests/contract/test_search_ui_filter_contract.py",
      "./.venv/bin/pytest -q documentation/tests/contract/test_search_facets_filters.py documentation/tests/contract/test_search_quality_performance.py documentation/tests/contract/test_search_integrity_drift.py"
    ],
    "release_gates": [
      "make test-docs-contract",
      "make test-docs-ui",
      "make test-docs-browser",
      "make test-release"
    ],
    "browser_required_for": [
      "real collapsed default height",
      "keyboard traversal",
      "localized label rendering in generated pages",
      "responsive no-overlap checks"
    ]
  },
  "non_goals": [
    "This contract does not implement the compact search UI.",
    "This contract does not change search ranking",
    "This contract does not change normalization, typo tolerance, corpus generation, or static index contents.",
    "This contract does not hand-edit generated HTML, manifests, search indexes, or installed app/documentation/site artifacts."
  ]
