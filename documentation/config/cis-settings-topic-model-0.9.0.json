      "ug-task-trace-setting-source"
    ]
  },
  "validation_contract": {
    "reject_certification_claims": true,
    "reject_source_expression_without_rights_approval": true,
    "reject_planned_topic_without_target": true,
    "reject_provenance_only_publishable_topic": true,
    "reject_missing_disclaimer": true,
    "reject_missing_source_title_hash": true
  },
  "generator_contract": {
    "skeleton_owner": "documentation/src/generated",
    "reviewed_topic_owner": "documentation/src/dita/{locale}/cis",
    "hand_authored_regions": [
      "disclaimer",
      "bpm-authored-summary",
      "conflicts",
      "verification",
      "limitations"
    ],
    "generated_regions": [
      "benchmark",
      "recommendation-identity",
      "bpm-mapping",
      "automation-state",
      "provenance"
    ],
    "regeneration_rule": "Regeneration may update generated factual regions only and must preserve reviewed prose and disclaimers byte-for-byte unless a review marker is changed."
  },
  "fixture_recommendation_ids": {
