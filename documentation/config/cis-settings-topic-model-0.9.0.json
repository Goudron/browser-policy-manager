  "disclaimer_contract": {
    "required_outputclass": "cis-disclaimer",
    "must_appear_in_sections": ["a-disclaimer", "a-provenance"],
    "required_statements": [
      "BPM is an independent implementation and is not authorized, sponsored, endorsed, certified, or approved by CIS.",
      "BPM documentation is not a substitute for the official CIS benchmark.",
      "BPM output does not prove CIS compliance.",
      "The official CIS PDF and source expression are not copied, translated, indexed, or packaged.",
      "BPM documents its own mappings, generated layers, merge behavior, manual-review states, and limitations in original prose.",
      "BPM has no separate persisted CIS exception or waiver model in 0.9.0."
    ],
    "forbidden_claims": [
      "CIS certified",
      "CIS-certified",
      "CIS endorsed",
      "CIS-approved guide",
      "authorized CIS guide",
      "guarantees CIS compliance",
      "proves CIS compliance",
      "complete benchmark substitute",
      "official CIS guidance"
    ]
  },
  "source_boundary": {
    "publishable_source_family_ids": [
      "bpm-cis-mapping-implementation",
      "cis-trademarks-and-certification-marks"
    ],
    "restricted_source_family_ids": ["cis-benchmark-pdf"],
    "benchmark_source_publication_policy": "approval-required",
    "source_expression_blocked_by_default": true,
    "rights_approval_id_required_for_benchmark_expression": true,
    "allowed_without_rights_approval": [
      "recommendation_id",
      "benchmark identity and version",
      "benchmark official source link",
      "source_title_sha256",
      "BPM-authored mapping facts",
      "BPM-authored workflow and verification guidance"
    ],
    "blocked_without_rights_approval": [
      "official PDF",
      "recommendation titles",
      "benchmark rationale prose",
      "audit prose",
      "remediation prose",
      "default-value prose",
      "substantial benchmark tables or screenshots"
    ]
  },
  "recommendation_model": {
    "recommendation_count": 55,
    "planned_topic_count": 53,
    "provenance_only_count": 2,
    "allowed_publication_dispositions": [
      "planned-dita-topic",
      "provenance-only-non-publishable"
    ],
    "supported_mapping_statuses": [
      "mapped",
      "preference_mapped",
      "needs_research",
      "deprecated_or_removed"
    ],
    "recommendation_id_format": "CIS dotted numeric identifier",
    "topic_slug_rule": "replace dots with hyphens",
    "doc_id_format": "cis-rec-{recommendation_id_slug}",
    "planned_topics_require_targets": true,
    "provenance_only_must_not_publish_topic": true,
    "source_title_hash_required": true
  },
  "automation_model": {
    "assessment_values": ["automated"],
    "supported_schema_channels": ["esr-115.38", "esr-140.13", "esr-153.0", "release-153"],
    "supported_levels": [1, 2],
    "generated_layer_fields": [
      "layer_id",
      "level",
      "schema_channel",
      "recommendation_count",
      "policy_top_level_count",
      "document_sha256",
      "file"
    ],
    "manual_review_path_count": 9,
    "exception_contract": {
      "persisted_exception_model": false,
      "documentation_statement_required": true
    }
  },
  "relationship_model": {
    "ui_targets": [
      "cis:{recommendation_id}",
      "policy:{policy_id}",
      "known-preference:{preference_id}"
    ],
    "firefox_policy_link_format": "policy:{target_id}",
    "firefox_preference_link_format": "known-preference:{target_id}",
    "user_guide_links": [
      "ug-task-apply-cis-layer",
      "ug-concept-cis-layer-merge",
