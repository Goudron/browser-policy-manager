          "app/documentation/assistant_capabilities.py",
          "app/documentation/conversation.py",
          "app/documentation/conversation_context.py",
          "app/documentation/conversation_diagnostics.py",
          "app/documentation/conversation_stream.py",
          "app/documentation/evidence.py",
          "app/documentation/evidence_relevance.py",
          "app/documentation/local_assistant_runtime.py",
          "app/documentation/response_timing.py",
