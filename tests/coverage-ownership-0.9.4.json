        "boundary": "Default-release API, database, service, web and template adapters are exercised through their semantic layer owners. They are not omitted from coverage configuration and cannot be represented by a synthetic line-coverage result."
      },
      {
        "id": "optional-incubation-delivery-boundary",
        "release_boundary_category": "optional_incubation",
        "ci_owners": ["ai-incubation-tests"],
        "boundary": "The optional modules are not loaded by the base wheel; their complete implementation inventory is the optional-ai-incubation strict coverage scope above."
      }
    ]
  },
  "documentation_library": {
    "policy": "documentation/config/coverage-policy-0.9.4.json",
    "line_threshold_percent": 100,
    "branch_threshold_percent": 100,
    "execution_layers": [
