    "function_threshold_percent": 100,
    "boundary": "This gate covers only extracted dependency-free modules. DOM, network, browser, and route adapters remain covered by their semantic Node and Chromium owners; they are not silently omitted from this declared pure-module gate."
  },
  "artifacts": {
    "python": "artifacts/coverage/python/",
